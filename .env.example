# Copy this file to .env and fill in real values. Never commit .env.
PORT=4000
# From Atlas -> Connect -> Drivers. Percent-encode special chars in the password (@ -> %40).
# Put the database name after .net/ or it defaults to "test".
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/lostfound?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=replace-with-a-long-random-string
# Deployed frontend address(es), comma-separated. Defaults to http://localhost:5173.
CORS_ORIGIN=http://localhost:5173
